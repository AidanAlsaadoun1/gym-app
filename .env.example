# Neon Postgres connection string. Get one at https://console.neon.tech
# Use the pooled connection string (ends with -pooler).
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# better-auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Public URL of the app. Same as BETTER_AUTH_URL in dev. Optional — the auth
# client uses the current browser origin at runtime, so this is only used by
# any future code that needs an absolute URL.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Bug reports (optional) -------------------------------------------------
# Resend account API key: https://resend.com/api-keys
RESEND_API_KEY=""
# Inbox the bug reports land in. With an un-verified Resend domain you can
# only send TO the email registered on your Resend account.
BUG_REPORT_TO_EMAIL=""
# Optional. Defaults to "Gym Bug Report <onboarding@resend.dev>" which works
# without verifying a domain. Once you've verified skyeapp.fit in Resend,
# switch this to e.g. "Gym <bugs@skyeapp.fit>".
BUG_REPORT_FROM_EMAIL=""
